# Copy this file to .env and paste your Google Cloud API key locally.
# Never commit .env or expose this key in frontend code.
GOOGLE_TRANSLATE_API_KEY=replace_with_your_google_cloud_api_key

# Backend settings
MAX_UPLOAD_MB=25
MAX_PAGES=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRANSLATION_CHUNK_CHARS=4000
TRANSLATION_RETRIES=3
TRANSLATION_TIMEOUT=30
BENGALI_FONT=/usr/share/fonts/truetype/noto/NotoSansBengali-Regular.ttf
BENGALI_FONT_BOLD=/usr/share/fonts/truetype/noto/NotoSansBengali-Bold.ttf
